# ==============================================================================
# RetailRadar AI — Environment Configuration Example
# ==============================================================================

# Supabase PostgreSQL & Authentication Configuration
# Create a free project at https://supabase.com
# Find these values in your Supabase Dashboard under Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# AI Intelligence Engine (Optional)
# Get an API key from Google AI Studio: https://aistudio.google.com
# If omitted or invalid, the platform automatically runs its built-in deterministic reasoning engine.
VITE_GEMINI_API_KEY=your-gemini-api-key

# Maps and Basemaps Providers
# CARTO Basemaps API key for high-contrast dark vector tiles (5M free requests/month)
VITE_MAPS_API_KEY=your-carto-maps-api-key
VITE_CARTO_API_KEY=your-carto-maps-api-key

# Optional: Google Maps Platform API key (if using Google Places)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
